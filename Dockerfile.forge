FROM python:3.9-slim

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PIP_NO_CACHE_DIR=1 \
    OPENVOICE_CKPT_DIR=/app/checkpoints_v2 \
    OPENVOICE_FORGE_PORT=7860

WORKDIR /app

RUN apt-get update && apt-get install -y --no-install-recommends \
    build-essential \
    curl \
    ffmpeg \
    git \
    libsndfile1 \
    unzip \
    && rm -rf /var/lib/apt/lists/*

COPY . /app

RUN python -m pip install --upgrade pip setuptools wheel \
    && pip install -e . \
    && pip install git+https://github.com/myshell-ai/MeloTTS.git \
    && python -m unidic download

RUN curl -fL --retry 4 --retry-delay 3 \
    https://myshell-public-repo-host.s3.amazonaws.com/openvoice/checkpoints_v2_0417.zip \
    -o /tmp/openvoice-v2.zip \
    && unzip -q /tmp/openvoice-v2.zip -d /app \
    && test -f /app/checkpoints_v2/converter/checkpoint.pth \
    && rm /tmp/openvoice-v2.zip

EXPOSE 7860

CMD ["python", "-m", "forge_app"]
